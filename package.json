{
  "name": "whos-next-browser",
  "version": "1.0.0",
  "description": "Suivi des prises de parole pendant le daily, dans le panneau latéral du navigateur",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "check:coverage": "node scripts/check-coverage.mjs",
    "lint:firefox": "web-ext lint --self-hosted --source-dir .output/firefox-mv3",
    "team-file": "node scripts/team-file-from-desktop.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^20.14.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0",
    "vitest": "^5.0.2",
    "web-ext": "^10.7.0",
    "wxt": "^0.21.4"
  }
}
